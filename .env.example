# Flask configuration
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=1
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Optional MySQL configuration. If DB_USER and DB_PASSWORD are unset, SQLite is used.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dbms

# Used only for locally seeded demo records and fallback records.
DEMO_ADMIN_PASSWORD=change-this-admin-password
DEMO_DONOR_PASSWORD=change-this-donor-password
